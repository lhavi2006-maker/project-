# Rename this file to ".env" (remove the ".example") and fill in your real values below.

# Port the backend server will run on
#PORT=5000

# Your MongoDB connection string (MongoDB Atlas or local)
# Example Atlas format:
# mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
#MONGO_URI=your_mongodb_connection_string_here

# Any long random string, used to sign JWT tokens
#JWT_SECRET=your_jwt_secret_here

# Your Google Gemini API key (from https://aistudio.google.com/app/apikey)
#GEMINI_API_KEY=your_google_gemini_api_key_here

#NODE_ENV=development
